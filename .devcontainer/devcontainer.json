{
  "name": "Fixture Generator",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "cd backend && python -m pip install --upgrade pip && python -m pip install -r requirements.lock && cd ../frontend && npm ci",
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": { "label": "Vite frontend", "onAutoForward": "openPreview" },
    "8000": { "label": "FastAPI backend", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.ruff", "dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
